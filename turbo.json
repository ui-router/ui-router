{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".node-version",
    ".nvmrc",
    ".npmrc",
    "package-lock.json"
  ],
  "tasks": {
    "clean": {
      "cache": false
    },
    "lint": {
      "cache": false,
      "outputs": []
    },
    "typecheck": {
      "cache": false,
      "outputs": []
    },
    "test": {
      "cache": false,
      "outputs": [],
      "env": ["CI"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "outputs": [],
      "env": ["CI"]
    },
    "build": {
      "dependsOn": ["^build", "clean"],
      "cache": false,
      "outputs": [],
      "env": ["NODE_ENV"]
    },
    "pack": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "outputs": [".artifacts/packages/**"]
    },
    "docs": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "outputs": [],
      "env": ["NODE_ENV"]
    },
    "e2e": {
      "cache": false,
      "outputs": ["test-results/**", "playwright-report/**"],
      "env": ["CI", "CYPRESS_CACHE_FOLDER", "PLAYWRIGHT_BROWSERS_PATH"]
    },
    "setup:browser": {
      "cache": false,
      "env": ["CYPRESS_CACHE_FOLDER", "PLAYWRIGHT_BROWSERS_PATH"]
    },
    "integration": {
      "cache": false
    },
    "release": {
      "cache": false
    },
    "publish": {
      "cache": false
    },
    "@uirouter/angular#build": {
      "dependsOn": ["^build", "clean"],
      "cache": false,
      "outputs": ["dist/**"],
      "env": ["NODE_ENV"]
    },
    "@uirouter/angular-hybrid#build": {
      "dependsOn": ["^build", "clean"],
      "cache": false,
      "outputs": ["dist/**"],
      "env": ["NODE_ENV"]
    },
    "@uirouter/angularjs#build": {
      "dependsOn": ["^build", "clean"],
      "cache": false,
      "outputs": ["lib-esm/**", "lib/**", "release/**"],
      "env": ["NODE_ENV"]
    },
    "@uirouter/core#build": {
      "dependsOn": ["^build", "clean"],
      "cache": false,
      "outputs": ["_bundles/**", "lib-esm/**", "lib/**"],
      "env": ["NODE_ENV"]
    },
    "@uirouter/dsr#build": {
      "dependsOn": ["^build", "clean"],
      "cache": false,
      "outputs": ["_bundles/**", "lib-esm/**", "lib/**"],
      "env": ["NODE_ENV"]
    },
    "@uirouter/internal-framework-angular-examples-sample-app#build": {
      "dependsOn": ["^build", "clean"],
      "cache": false,
      "outputs": ["dist/**"],
      "env": ["NODE_ENV"]
    },
    "@uirouter/internal-framework-angular-hybrid-examples-example#build": {
      "dependsOn": ["^build", "clean"],
      "cache": false,
      "outputs": ["_bundles/**"],
      "env": ["NODE_ENV"]
    },
    "@uirouter/internal-framework-angular-hybrid-examples-sample-app#build": {
      "dependsOn": ["^build", "clean"],
      "cache": false,
      "outputs": ["dist/**"],
      "env": ["NODE_ENV"]
    },
    "@uirouter/internal-framework-angularjs-examples-sample-app#build": {
      "dependsOn": ["^build", "clean"],
      "cache": false,
      "outputs": ["dist/**"],
      "env": ["NODE_ENV"]
    },
    "@uirouter/internal-framework-react-examples-animating-transitions#build": {
      "dependsOn": ["^build", "clean"],
      "cache": false,
      "outputs": ["build/**"],
      "env": ["NODE_ENV"]
    },
    "@uirouter/internal-framework-react-examples-sample-app#build": {
      "dependsOn": ["^build", "clean"],
      "cache": false,
      "outputs": ["docs/**"],
      "env": ["NODE_ENV"]
    },
    "@uirouter/internal-plugins-dsr-examples-angular-cli#build": {
      "dependsOn": ["^build", "clean"],
      "cache": false,
      "outputs": ["dist/**"],
      "env": ["NODE_ENV"]
    },
    "@uirouter/internal-plugins-dsr-examples-angularjs-webpack#build": {
      "dependsOn": ["^build", "clean"],
      "cache": false,
      "outputs": ["bundle.js"],
      "env": ["NODE_ENV"]
    },
    "@uirouter/internal-plugins-dsr-examples-react-vite#build": {
      "dependsOn": ["^build", "clean"],
      "cache": false,
      "outputs": ["dist/**"],
      "env": ["NODE_ENV"]
    },
    "@uirouter/internal-plugins-redux-examples-react#build": {
      "dependsOn": ["^build", "clean"],
      "cache": false,
      "outputs": ["dist/**"],
      "env": ["NODE_ENV"]
    },
    "@uirouter/internal-plugins-sticky-states-examples-angular-cli#build": {
      "dependsOn": ["^build", "clean"],
      "cache": false,
      "outputs": ["dist/**"],
      "env": ["NODE_ENV"]
    },
    "@uirouter/internal-plugins-sticky-states-examples-angularjs-webpack#build": {
