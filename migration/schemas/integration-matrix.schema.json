                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "productionEdgeIds": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "evidence": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "sha256"],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              }
            }
          },
          "expectedResult": {
            "enum": ["pass", "waived-failure", "inventory-only"]
          },
          "waiver": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "baselineId",
                  "owner",
                  "reason",
                  "trackingIssue",
                  "expires"
                ],
                "properties": {
                  "baselineId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "owner": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "trackingIssue": {
                    "type": "string",
                    "pattern": "^https://github\\.com/ui-router/ui-router/issues/[0-9]+$"
                  },
                  "expires": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            ]
          },
          "expectedFailure": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["phase", "contains"],
                "properties": {
                  "phase": {
                    "const": "lock"
                  },
                  "contains": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            ]
          },
          "projectNpmrc": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "sha256", "allowedSettings"],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.npmrc$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "allowedSettings": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["prefer-dedupe"],
                    "properties": {
                      "prefer-dedupe": {
                        "const": "true"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "commandAdapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner",
          "invokedAs",
          "package",
          "allowedProjects",
          "implementation",
          "script",
          "scriptSha256",
          "reason"
