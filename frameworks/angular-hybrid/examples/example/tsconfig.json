{
  "files": ["src/main.ts"],
  "compilerOptions": {
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "module": "es6",
    "moduleResolution": "bundler",
    "target": "es6",
    "rootDir": "src",
    "outDir": "transpiled",
    "paths": {
      "@uirouter/angular": ["../../../angular/uirouter-angular/dist"],
      "@uirouter/angular-hybrid": ["../../uirouter-angular-hybrid/dist"]
    },
    "declaration": false,
    "sourceMap": true,
    "skipLibCheck": true,
    "lib": ["es6", "dom"]
  }
}
