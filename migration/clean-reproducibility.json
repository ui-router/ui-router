      "argv": ["node", "tools/verify-ci-docs-waivers.mjs", "--output", ".ci-results/docs/waivers.json"]
    },
    {
      "id": "cleanup-browser",
      "argv": ["node", "tools/prepare-workspace-browser.mjs", "--cleanup"]
    }
  ],
  "proof": {
    "runs": 2,
    "output": ".ci-results/reproducibility/proof.json",
