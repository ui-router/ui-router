    {
      "id": "build",
      "argv": ["npm", "run", "build", "--", "--cache=local:"]
    },
    {
      "id": "test",
      "argv": ["npm", "run", "test", "--", "--cache=local:", "--env-mode=loose"]
    },
    {
      "id": "prove-packages",
      "argv": ["npm", "run", "prove:package-artifacts"]
    },
    {
      "id": "stage-packages",
      "argv": ["node", "tools/stage-ci-package-artifacts.mjs", "--output", ".ci-artifacts/packages"]
