        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/migration/source-aliases.json",
        "$TURBO_ROOT$/tools/source-aliases.cjs",
        "$TURBO_ROOT$/core/src/**"
      ],
      "outputs": []
