{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-router.github.io/migration/schemas/integration-run-lock.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "fixtureId", "repositoryCommit", "matrixSha256", "packageClassificationSha256", "platform", "node", "npm", "browser", "commandSha256", "originalManifestSha256", "originalLockSha256", "tarballs", "stagedManifestSha256", "temporaryLockSha256", "externalGraphSha256", "installedGraphSha256", "evidence"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "$ref": "contract-common.schema.json#/$defs/identifier" },
    "fixtureId": { "$ref": "contract-common.schema.json#/$defs/identifier" },
    "repositoryCommit": { "$ref": "contract-common.schema.json#/$defs/objectId" },
    "matrixSha256": { "$ref": "contract-common.schema.json#/$defs/sha256" },
    "packageClassificationSha256": { "$ref": "contract-common.schema.json#/$defs/sha256" },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["osImageDigest", "architecture", "timezone", "locale"],
      "properties": {
        "osImageDigest": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "timezone": { "type": "string", "minLength": 1 },
        "locale": { "type": "string", "minLength": 1 }
      }
    },
    "node": { "type": "string", "minLength": 1 },
    "npm": { "type": "string", "minLength": 1 },
    "browser": { "$ref": "integration-matrix.schema.json#/$defs/browser" },
    "commandSha256": { "$ref": "contract-common.schema.json#/$defs/sha256" },
    "originalManifestSha256": { "$ref": "contract-common.schema.json#/$defs/sha256" },
    "originalLockSha256": { "$ref": "contract-common.schema.json#/$defs/sha256" },
    "tarballs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactId", "package", "version", "path", "sha256"],
        "properties": {
          "artifactId": { "$ref": "contract-common.schema.json#/$defs/identifier" },
          "package": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "path": { "$ref": "contract-common.schema.json#/$defs/relativePath" },
          "sha256": { "$ref": "contract-common.schema.json#/$defs/sha256" }
        }
      }
    },
    "stagedManifestSha256": { "$ref": "contract-common.schema.json#/$defs/sha256" },
    "temporaryLockSha256": { "$ref": "contract-common.schema.json#/$defs/sha256" },
    "externalGraphSha256": { "$ref": "contract-common.schema.json#/$defs/sha256" },
    "installedGraphSha256": { "$ref": "contract-common.schema.json#/$defs/sha256" },
    "evidence": { "$ref": "contract-common.schema.json#/$defs/evidence" }
  }
}
