{
  "name": "@uirouter/internal-framework-react-hybrid-integration-react16",
  "private": true,
  "description": "Integration test for @uirouter/react-hybrid with React 16",
  "version": "0.1.0",
  "dependencies": {
    "@uirouter/react-hybrid": "latest",
