      "id": "publish-scripts",
      "manifest": "tools/publish-scripts/package.json",
      "package": "@uirouter/publish-scripts",
      "kind": "cli",
      "build": null,
      "pack": {
        "directory": ".",
        "allowed": [
          "package.json",
          "artifact_tagging.js",
          "docgen_via_docker.sh",
          "ensure_clean_master.js",
          "modify_sourcemap_paths.js",
          "publish_docs.js",
          "publish_yalc_package.js",
          "release.js",
          "prepare_release.js",
          "show_changelog.js",
          "show_version.js",
          "test_downstream_projects.js",
          "util.js"
        ],
        "required": [
          "package.json",
          "artifact_tagging.js",
          "docgen_via_docker.sh",
          "ensure_clean_master.js",
          "modify_sourcemap_paths.js",
          "publish_docs.js",
          "publish_yalc_package.js",
          "release.js",
          "prepare_release.js",
          "show_changelog.js",
          "test_downstream_projects.js",
          "util.js"
        ]
      },
      "entrypoints": [
        {
          "id": "publish-scripts-artifact-tagging",
          "mode": "bin",
          "specifier": "artifact_tagging",
          "target": "artifact_tagging.js",
          "export": null
        },
        {
          "id": "publish-scripts-ensure-clean-master",
          "mode": "bin",
          "specifier": "ensure_clean_master",
          "target": "ensure_clean_master.js",
          "export": null
        },
        {
          "id": "publish-scripts-generate-docs",
          "mode": "bin",
          "specifier": "generate_docs",
          "target": "docgen_via_docker.sh",
          "export": null
        },
        {
          "id": "publish-scripts-modify-sourcemap-paths",
          "mode": "bin",
          "specifier": "modify_sourcemap_paths",
          "target": "modify_sourcemap_paths.js",
          "export": null
        },
        {
          "id": "publish-scripts-publish-docs",
          "mode": "bin",
          "specifier": "publish_docs",
          "target": "publish_docs.js",
          "export": null
        },
        {
          "id": "publish-scripts-publish-yalc-package",
          "mode": "bin",
          "specifier": "publish_yalc_package",
          "target": "publish_yalc_package.js",
          "export": null
        },
        {
          "id": "publish-scripts-release",
          "mode": "bin",
          "specifier": "release",
          "target": "release.js",
          "export": null
        },
        {
          "id": "publish-scripts-show-changelog",
          "mode": "bin",
          "specifier": "show_changelog",
          "target": "show_changelog.js",
          "export": null
        },
        {
          "id": "publish-scripts-test-downstream",
          "mode": "bin",
          "specifier": "test_downstream_projects",
          "target": "test_downstream_projects.js",
          "export": null
        },
        {
          "id": "publish-scripts-util",
          "mode": "bin",
          "specifier": "util",
          "target": "util.js",
          "export": null
        }
      ],
      "tagNamespace": "publish-scripts@",
      "historicalDirectory": "tools/publish-scripts"
    }
  ],
  "artifactPolicy": {
    "directory": ".artifacts/packages",
    "npmPackArgv": [
      "npm",
      "pack",
      "--ignore-scripts",
      "--json",
      "--pack-destination"
    ],
    "forbiddenPatterns": [
      "(^|/)node_modules(/|$)",
      "(^|/)(src|test|tests|examples|integration-tests)(/|$)",
      "(^|/)package-lock.json$",
      "(^|/)(tsconfig|typedoc|vitest|jest|karma|rollup|rolldown|webpack|eslint)[^/]*$",
      "(^|/)downstream_projects.json$",
      "(^|/)artifacts.json$",
      "(^|/).*\\.legacy(\\.[^/]*)?$",
      "tools/source-aliases.json",
      "tools/source-aliases.cjs"
    ]
  },
  "consumer": {
    "name": "@uirouter/packed-consumer",
    "dependencies": {
      "@angular/common": "22.1.3",
      "@angular/compiler": "22.1.3",
      "@angular/core": "22.1.3",
      "@angular/upgrade": "22.1.3",
      "@types/angular": "1.8.9",
      "@types/jquery": "3.5.34",
      "@types/node": "24.13.3",
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.5",
      "angular": "1.8.3",
      "jsdom": "27.4.0",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "react-redux": "9.3.0",
      "redux": "5.0.1",
      "rxjs": "7.8.2",
      "zone.js": "0.16.2"
    },
    "typecheck": {
      "typescript": "5.9.3",
      "command": [
        "node_modules/.bin/tsc",
        "--project",
        "tsconfig.json",
        "--noEmit"
      ]
    },
    "bundler": {
      "package": "esbuild",
      "version": "0.28.2",
      "command": [
        "node_modules/.bin/esbuild",
        "bundler-probe.ts",
        "--bundle",
        "--format=esm",
        "--platform=browser",
        "--outfile=bundler-probe.mjs"
      ]
    }
  }
}
