      "build": {
        "cleanPaths": [
          "lib",
          "lib-esm",
          "_bundles"
        ]
      },
      "pack": {
        "directory": ".",
        "allowed": [
          "package.json",
          "README.md",
          "LICENSE",
          "lib/**",
          "lib-esm/**",
          "_bundles/**"
