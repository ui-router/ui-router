{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-router.github.io/migration/schemas/execution-lock.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "decisionDate", "targetBase", "targetBaseSourceManifestSha256", "sourceManifestSha256", "toolchain", "sources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "decisionDate": { "type": "string", "format": "date" },
    "targetBase": { "$ref": "contract-common.schema.json#/$defs/objectId" },
    "targetBaseSourceManifestSha256": { "$ref": "contract-common.schema.json#/$defs/sha256" },
    "sourceManifestSha256": { "$ref": "contract-common.schema.json#/$defs/sha256" },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "nodeLtsLine", "npm", "git", "python", "pythonExecutable", "pythonExecutableSha256", "uv", "gitFilterRepo", "contractSchemaValidator", "contractSchemaBundleSha256", "runtime"],
      "properties": {
        "node": { "type": "string", "minLength": 1 },
        "nodeLtsLine": { "type": "string", "pattern": "^[0-9]+$" },
        "npm": { "type": "string", "minLength": 1 },
        "git": { "type": "string", "minLength": 1 },
        "python": { "type": "string", "minLength": 1 },
        "pythonExecutable": { "type": "string", "pattern": "^/" },
        "pythonExecutableSha256": { "$ref": "contract-common.schema.json#/$defs/sha256" },
        "uv": { "type": "string", "minLength": 1 },
        "contractSchemaBundleSha256": { "$ref": "contract-common.schema.json#/$defs/sha256" },
        "contractSchemaValidator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "artifactPath", "artifactSha256"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "artifactPath": { "$ref": "contract-common.schema.json#/$defs/relativePath" },
            "artifactSha256": { "$ref": "contract-common.schema.json#/$defs/sha256" }
          }
        },
        "gitFilterRepo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["packageVersion", "reportedVersion", "artifactPath", "artifactSha256", "wrapperPath", "wrapperSha256"],
          "properties": {
            "packageVersion": { "type": "string", "minLength": 1 },
            "reportedVersion": { "type": "string", "minLength": 1 },
            "artifactPath": { "$ref": "contract-common.schema.json#/$defs/relativePath" },
            "artifactSha256": { "$ref": "contract-common.schema.json#/$defs/sha256" },
            "wrapperPath": { "$ref": "contract-common.schema.json#/$defs/relativePath" },
            "wrapperSha256": { "$ref": "contract-common.schema.json#/$defs/sha256" }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["osImage", "osImageDigest", "architecture", "timezone", "locale", "browser"],
          "properties": {
            "osImage": { "type": "string", "minLength": 1 },
            "osImageDigest": { "type": "string", "minLength": 1 },
            "architecture": { "type": "string", "minLength": 1 },
            "timezone": { "type": "string", "minLength": 1 },
            "locale": { "type": "string", "minLength": 1 },
            "browser": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "revision", "installerVersion", "sha256"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "revision": { "type": "string", "minLength": 1 },
                    "installerVersion": { "type": "string", "minLength": 1 },
                    "sha256": { "$ref": "contract-common.schema.json#/$defs/sha256" }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "defaultHead", "tagSnapshotSha256", "mirrorPath", "bundlePath", "bundleSha256", "objectFormat", "includedRefs", "retentionOwner", "evidence"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "defaultHead": { "$ref": "contract-common.schema.json#/$defs/objectId" },
          "tagSnapshotSha256": { "$ref": "contract-common.schema.json#/$defs/sha256" },
          "mirrorPath": { "$ref": "contract-common.schema.json#/$defs/relativePath" },
          "bundlePath": { "$ref": "contract-common.schema.json#/$defs/relativePath" },
          "bundleSha256": { "$ref": "contract-common.schema.json#/$defs/sha256" },
          "objectFormat": { "enum": ["sha1"] },
          "includedRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^refs/" } },
          "retentionOwner": { "type": "string", "minLength": 1 },
          "evidence": { "$ref": "contract-common.schema.json#/$defs/evidence" }
        }
      }
    }
  }
}
