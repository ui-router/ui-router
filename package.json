{
  "name": "@uirouter/monorepo",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.17.0",
      "onFail": "error"
    }
  },
  "workspaces": [
    "core",
    "plugins/*",
    "plugins/*/examples/*",
    "frameworks/*/uirouter-*",
    "frameworks/*/examples/*",
    "tools/*"
  ],
  "scripts": {
    "build": "turbo run build --filter='./core' --filter='./frameworks/*/uirouter-*' --filter='./plugins/*'",
    "pack": "turbo run pack --filter='./core' --filter='./frameworks/*/uirouter-*' --filter='./plugins/*' --filter='./tools/publish-scripts'",
    "build:workspaces": "turbo run build",
    "lint": "turbo run lint --filter='./core' --filter='./frameworks/*/uirouter-*' --filter='./plugins/*'",
    "typecheck": "turbo run typecheck --filter='./core' --filter='./frameworks/*/uirouter-*' --filter='./plugins/*'",
    "test": "turbo run test --filter='./core' --filter='./frameworks/*/uirouter-*' --filter='./plugins/*'",
    "test:watch": "turbo run test:watch --filter='./core' --filter='./frameworks/*/uirouter-*' --filter='./plugins/*' --concurrency=16",
    "docs": "turbo run docs --filter='./core' --filter='./frameworks/*/uirouter-*' --filter='./plugins/*'",
    "setup:browser": "turbo run setup:browser --filter='./frameworks/*/examples/*' --filter='./plugins/*/examples/*'",
    "e2e": "turbo run e2e --filter='./frameworks/*/examples/*' --filter='./plugins/*/examples/*'",
    "check": "npm run verify:turbo && node tools/run-clean-static-gates.mjs && npm run prove:package-artifacts",
    "check:static": "npm run verify:root-config && npm run verify:manifests && npm run verify:locks && npm run verify:package-manager && npm run verify:layout && npm run verify:internal-deps && npm run verify:s01 && npm run verify:source-aliases && npm run verify:turbo && npm run verify:isolated && npm run verify:package-artifacts && npm run verify:integration-matrix && npm run verify:integration-evidence && npm run verify:ci && npm run verify:reproducibility && npm run verify:contracts && npm run verify:work-graph",
    "check:static:installed": "npm run verify:root-config && npm run verify:manifests && npm run verify:package-manager && npm run verify:internal-deps && npm run verify:s01 && npm run verify:source-aliases && npm run verify:turbo && npm run verify:isolated && npm run verify:package-artifacts && npm run verify:integration-matrix && npm run verify:integration-evidence && npm run verify:ci && npm run verify:reproducibility && npm run verify:contracts && npm run verify:work-graph",
    "verify:root-config": "node tools/verify-root-config.mjs",
    "verify:manifests": "node tools/verify-manifest-normalization.mjs",
    "verify:locks": "node tools/verify-npm-locks.mjs",
    "verify:package-manager": "node tools/verify-package-manager.mjs",
    "verify:layout": "node tools/verify-layout.mjs",
    "verify:internal-deps": "node tools/verify-internal-deps.mjs",
    "verify:s01": "node tools/verify-s01-scripts.mjs",
    "test:s01": "node tools/test-s01-scripts.mjs",
    "verify:source-aliases": "node tools/verify-source-aliases.mjs",
    "test:source-aliases": "node tools/test-source-aliases.mjs",
    "verify:turbo": "node tools/verify-turbo-graph.mjs",
    "test:turbo": "node tools/test-turbo-graph.mjs",
    "prove:turbo": "node tools/prove-turbo-graph.mjs",
    "prove:source-commands": "node tools/prove-source-commands.mjs",
    "prove:source-watch": "node tools/prove-source-watch.mjs",
    "prove:source-packs": "node tools/prove-source-packs.mjs",
    "verify:isolated": "node tools/run-immutable-i01-gate.mjs verify",
    "test:isolated": "node tools/run-immutable-i01-gate.mjs test",
    "prove:isolated-installs": "node tools/prove-npm-installs.mjs --expected migration/evidence/i01/install-proof.json",
    "verify:package-artifacts": "node tools/verify-package-artifacts.mjs",
    "test:package-artifacts": "node tools/test-package-artifacts.mjs",
    "prove:package-artifacts": "node tools/prove-package-artifacts.mjs",
    "verify:integration-matrix": "node tools/verify-integration-matrix.mjs",
    "test:integration-matrix": "node tools/test-integration-matrix.mjs && node tools/test-integration-runner.mjs",
    "verify:integration-run": "node tools/verify-integration-run.mjs",
    "verify:integration-evidence": "node tools/verify-integration-evidence.mjs",
    "verify:ci": "node tools/verify-ci-gates.mjs",
    "test:ci-gates": "node tools/test-ci-gates.mjs",
    "verify:reproducibility": "node tools/verify-clean-reproducibility.mjs",
    "test:reproducibility": "node tools/test-clean-reproducibility.mjs",
    "prove:reproducibility": "node tools/prove-clean-reproducibility.mjs",
    "verify:docs-waivers": "node tools/verify-ci-docs-waivers.mjs --output .ci-results/docs/waivers.json",
    "prove:integration-matrix": "node tools/run-integration-matrix.mjs --write",
    "test:n04-validators": "node tools/test-n04-validators.mjs",
    "test:n04-installed": "node tools/test-n04-installed.mjs",
    "test:n05-package-manager": "node tools/test-n05-package-manager.mjs",
    "prove:installs": "node tools/prove-npm-installs.mjs",
    "prove:installs:ci": "node tools/prove-npm-installs.mjs --write .ci-results/contracts/install-proof.json",
    "verify:contracts": "node tools/verify-contract-schemas.mjs",
    "verify:work-graph": "node tools/verify-work-graph.mjs",
    "test:history-migration": "node tools/test-history-migration.mjs"
  },
  "devDependencies": {
    "turbo": "2.10.12",
    "typescript-p01": "npm:typescript@5.9.3"
  }
}
