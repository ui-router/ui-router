    "@uirouter/internal-plugins-sticky-states-examples-react-vite#build": {
      "dependsOn": ["^build", "clean"],
      "cache": false,
      "outputs": ["dist/**"],
      "env": ["NODE_ENV"]
    },
    "@uirouter/react#build": {
      "dependsOn": ["^build", "clean"],
      "cache": false,
      "outputs": ["_bundles/**", "lib-esm/**", "lib/**"],
      "env": ["NODE_ENV"]
    },
    "@uirouter/react-hybrid#build": {
      "dependsOn": ["^build", "clean"],
      "cache": false,
      "outputs": ["_bundles/**", "lib-esm/**", "lib/**"],
      "env": ["NODE_ENV"]
    },
    "@uirouter/redux#build": {
      "dependsOn": ["^build", "clean"],
      "cache": false,
      "outputs": ["dist/**"],
      "env": ["NODE_ENV"]
    },
    "@uirouter/rx#build": {
      "dependsOn": ["^build", "clean"],
      "cache": false,
      "outputs": ["_bundles/**", "lib-esm/**", "lib/**"],
      "env": ["NODE_ENV"]
    },
    "@uirouter/sticky-states#build": {
      "dependsOn": ["^build", "clean"],
      "cache": false,
      "outputs": ["_bundles/**", "lib-esm/**", "lib/**"],
      "env": ["NODE_ENV"]
    },
    "@uirouter/visualizer#build": {
      "dependsOn": ["^build", "clean"],
      "cache": false,
      "outputs": ["_bundles/**", "lib-esm/**", "lib/**"],
      "env": ["NODE_ENV"]
    },
    "@uirouter/angular#docs": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "outputs": ["_doc/**"],
      "env": ["NODE_ENV"]
    },
    "@uirouter/angularjs#docs": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "outputs": ["_doc/**"],
      "env": ["NODE_ENV"]
    },
    "@uirouter/core#docs": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "outputs": ["_doc/**"],
      "env": ["NODE_ENV"]
    },
    "@uirouter/react#docs": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "outputs": ["_doc/**"],
      "env": ["NODE_ENV"]
    },
    "@uirouter/angular#test": {
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/migration/source-aliases.json",
        "$TURBO_ROOT$/tools/source-aliases.cjs",
        "$TURBO_ROOT$/core/src/**",
        "$TURBO_ROOT$/plugins/rx/src/**"
      ],
      "outputs": [],
      "env": ["CI"]
    },
    "@uirouter/angular#test:watch": {
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "inputs": [
        "$TURBO_DEFAULT$",
